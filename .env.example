# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.
# Placeholders only in this file. Real values live in .env.local (dev) and in the
# host's environment settings (production).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical/OG URLs and the JSON-LD @id graph, so a preview deploy
# describes itself rather than claiming to be production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MongoDB — required for the enquiry form to store anything
# ---------------------------------------------------------------------------
# Atlas free tier (M0) is enough for this. Format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Without this the site still serves; POST /api/enquiries answers 503 with a reason.
MONGODB_URI=
MONGODB_DB=innovgeist

# Admin portal. Set a strong password before using /admin.
ADMIN_PASSWORD=

# Guardian accounts (/account). Signs the session cookie — must be a long random
# value, and must NOT be the same secret as ADMIN_PASSWORD. Without this set,
# sign-up/sign-in answer 503.
ACCOUNT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email notification (optional — the enquiry is stored either way)
# ---------------------------------------------------------------------------
# Resend. FROM must be on a domain verified in the Resend dashboard, or every
# send is rejected with a 403 that says nothing useful.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_NOTIFY_EMAIL=support@innovgeist.com
ENQUIRY_NOTIFY_CC=

# ---------------------------------------------------------------------------
# Razorpay — NOT USED YET
# ---------------------------------------------------------------------------
# Carried over from the rakhi-app project so the course checkout has them when it
# lands. Nothing in the current build reads these.
#
# ⚠️ A LIVE KEY (rzp_live_…) CHARGES REAL CARDS. The convention carried over with
# these keys is that live keys are refused unless RAZORPAY_ALLOW_LIVE=true is set
# deliberately, on the production deploy and nowhere else.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=
